import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        for(int i=2;i<=n;i++) {
            int c=0;
            for(int j=i;j>=2;j--) {
                if(i%j==0) {
                    c+=1;
                }
            }
            if(c==1) {
                System.out.println(i+" ");
            }
        }
    }
}
